# NODE_ENV=development
# APP_NAME="SAW - REQUESTS API"

# # Server
# HOST=0.0.0.0
# PORT=4001
# API_PREFIX=api

# # Frontend origin. Use comma-separated values for multiple domains.
# CORS_ORIGIN=http://localhost:3000
# CORS_CREDENTIALS=true

# # Database
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# # Set local to use the local PostgreSQL settings below instead of DATABASE_URL.
# DATABASE_MODE=local
# LOCAL_DATABASE_HOST=127.0.0.1
# LOCAL_DATABASE_PORT=5432
# LOCAL_DATABASE_USER=postgres
# LOCAL_DATABASE_NAME=saw_requests
# LOCAL_DATABASE_PASSWORD=your-local-postgres-password

# # Files
# UPLOAD_DIR=uploads
# UPLOAD_URL_PREFIX=/api/uploads/
# MAX_UPLOAD_FILE_SIZE_MB=15

# # API docs
# SWAGGER_ENABLED=true
# SWAGGER_PATH=api/docs

# # Security
# BCRYPT_SALT_ROUNDS=10

# # Email tài khoản mới
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM="SAW - REQUESTS <your-account@gmail.com>"
# SMTP_REPLY_TO=your-account@gmail.com
# FRONTEND_URL=https://saw.sicom.com.vn
# VAPID_SUBJECT=mailto:admin@sicom.com.vn
# VAPID_PUBLIC_KEY=generate-with-web-push
# VAPID_PRIVATE_KEY=generate-with-web-push
